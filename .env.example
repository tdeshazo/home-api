APP_ENV=development
AUTH_MODE=dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_api?sslmode=disable
PORT=8080
LOG_LEVEL=info
LOG_FILE=
LOG_SOURCE=false

# Required when AUTH_MODE=jwt.
# This scaffold validates HS256 tokens where the JWT subject is the user UUID.
JWT_SECRET=change-me
JWT_ISSUER=home-api
JWT_AUDIENCE=home-api-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
